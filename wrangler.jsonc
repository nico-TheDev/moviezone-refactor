{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "moviezone-refactor",
    "main": "./server/worker.ts",
    "compatibility_date": "2026-10-12",
    // nodejs_compat exposes vars and secrets on process.env, which server/env.ts reads.
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "./build/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // Only API calls run the Worker. Static files and SPA routes are served straight from
        // the asset store, which is free and unmetered, with headers from public/_headers.
        "run_worker_first": ["/api/*", "/health"]
    },
    // Edge rate limits read by server/middleware/rate-limit.ts. Period must be 10 or 60, so
    // auth is 5 per minute here rather than the 10 per 5 minutes the Node fallback uses.
    // namespace_id only has to be unique within the Cloudflare account.
    "ratelimits": [
        { "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SESSION", "namespace_id": "1004", "simple": { "limit": 200, "period": 60 } }
    ],
    // Secrets (set in the Cloudflare dashboard or with `wrangler secret put`):
    // TMDB_BEARER_TOKEN, TMDB_API_KEY. Upstash is not needed here, the bindings above replace it.
    "vars": {
        "NODE_ENV": "production"
    },
    "observability": {
        "enabled": true
    }
}
